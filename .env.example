# Copy to .env and replace REQUIRED_* values before enabling production adapters.
APP_ENV=local
ESPEON_GITHUB_TOKEN=
JEV_RUNTIME_DIR=C:/JevCTraderV1/runtime-harness
QDRANT_MODE=local
QDRANT_LOCAL_PATH=C:/JevCTraderV1/runtime-harness/qdrant
QDRANT_COLLECTION=jev_context_pool
QDRANT_URL=
QDRANT_API_KEY=
CONTEXT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
CONTEXT_SPARSE_MODEL=Qdrant/bm25
WORLD_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=REQUIRED_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WORLD_MODEL_BASE_MODEL=openai/gpt-6-luna-pro
WORLD_MODEL_ESCALATION_MODEL_1=anthropic/claude-opus-5.5
WORLD_MODEL_WEB_SEARCH_ENABLED=true
AUTONOMOUS_REVIEW_ENABLED=true
REVIEW_NO_TRADE_HORIZON_MODE=hypothesis_horizon
REVIEW_NO_TRADE_MIN_DECISIONS=6
REVIEW_NO_TRADE_MAX_DECISIONS=20
REVIEW_CONSECUTIVE_LOSSES=3
REVIEW_PERIODIC_TRADES=10
REVIEW_MAX_ACTIVE_LOOPS=3
REVIEW_SPLIT_CONFIDENCE=0.80
WORLD_MODEL_REVIEW_CONFIDENCE_THRESHOLD=0.70
WORLD_MODEL_CONTRADICTION_CONFIDENCE_THRESHOLD=0.80
REVIEW_RETRY_ATTEMPTS=3
REVIEW_RETRY_BASE_SECONDS=5
JEV_PROVIDER=primary
JEV_API_KEY=REQUIRED_JEV_API_KEY
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=
CTRADER_MCP_ENABLED=false
CTRADER_MCP_ENDPOINT=
CTRADER_MCP_AUTH_TOKEN=
CTRADER_MCP_ACCOUNT_ID=
CTRADER_OPEN_API_ENVIRONMENT=demo
CTRADER_OPEN_API_CLIENT_ID=REQUIRED_CTRADER_OPEN_API_CLIENT_ID
CTRADER_OPEN_API_CLIENT_SECRET=REQUIRED_CTRADER_OPEN_API_CLIENT_SECRET
CTRADER_OPEN_API_ACCESS_TOKEN=REQUIRED_CTRADER_OPEN_API_ACCESS_TOKEN
CTRADER_OPEN_API_REFRESH_TOKEN=
CTRADER_OPEN_API_ACCOUNT_ID=REQUIRED_CTRADER_OPEN_API_ACCOUNT_ID
CTRADER_OPEN_API_SYMBOL_MAP=REQUIRED_CTRADER_OPEN_API_SYMBOL_MAP
CTRADER_OPEN_API_PORT=5035
CTRADER_OPEN_API_TIMEOUT_SECONDS=15
CTRADER_MARKET_QUOTE_MAX_AGE_SECONDS=15
CTRADER_MARKET_HISTORY_DEPTH=250
CTRADER_FIX_PRICE_HOST=REQUIRED_CTRADER_FIX_PRICE_HOST
CTRADER_FIX_PRICE_PORT=REQUIRED_CTRADER_FIX_PRICE_PORT
CTRADER_FIX_PRICE_SSL=true
CTRADER_FIX_PRICE_USERNAME=REQUIRED_CTRADER_FIX_PRICE_USERNAME
CTRADER_FIX_PRICE_PASSWORD=REQUIRED_CTRADER_FIX_PRICE_PASSWORD
CTRADER_FIX_PRICE_SENDER_COMP_ID=REQUIRED_CTRADER_FIX_PRICE_SENDER_COMP_ID
CTRADER_FIX_PRICE_SENDER_SUB_ID=QUOTE
CTRADER_FIX_PRICE_TARGET_COMP_ID=CSERVER
CTRADER_FIX_PRICE_TARGET_SUB_ID=QUOTE
CTRADER_FIX_TRADE_HOST=REQUIRED_CTRADER_FIX_TRADE_HOST
CTRADER_FIX_TRADE_PORT=REQUIRED_CTRADER_FIX_TRADE_PORT
CTRADER_FIX_TRADE_SSL=true
CTRADER_FIX_TRADE_USERNAME=REQUIRED_CTRADER_FIX_TRADE_USERNAME
CTRADER_FIX_TRADE_PASSWORD=REQUIRED_CTRADER_FIX_TRADE_PASSWORD
CTRADER_FIX_TRADE_SENDER_COMP_ID=REQUIRED_CTRADER_FIX_TRADE_SENDER_COMP_ID
CTRADER_FIX_TRADE_SENDER_SUB_ID=TRADE
CTRADER_FIX_TRADE_TARGET_COMP_ID=CSERVER
CTRADER_FIX_TRADE_TARGET_SUB_ID=TRADE
